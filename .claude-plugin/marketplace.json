  "metadata": {
    "description": "Marketplace of Claude Code / Cowork plugins for preparing U.S. court documents — one plugin per state plus two shared federal reference plugins (us-federal-debt-corpus and us-federal-immigration-corpus). Each plugin ships matter-neutral civil-procedure skills plus subject-matter bundles and verbatim reference corpora; the state plugins depend on us-federal-debt-corpus for the shared federal / UCC / Bankruptcy content. Per-plugin detail lives in each plugin's README.md. Currently ten state plugins (WA, OR, CA, CO, IN, NY, OH, TN, MI, AZ) plus the two shared plugins.",
    "version": "0.27.2"
  },
  "plugins": [
    {
      "name": "us-federal-debt-corpus",
      "source": "./plugins/us-federal-debt-corpus",
      "description": "Shared federal reference plugin: canonical FDCPA / FCRA / TILA / ECOA / Reg B-Z + RESPA / SCRA / FHA / FTC Telemarketing Sales Rule, the Title 11 Bankruptcy Code, and the model UCC (a dependency of every state plugin, dereferenced from in-tree symlinks at install time), plus a nationwide FCRA consumer credit-report-rights skills layer. Full detail in the plugin README.",
      "category": "legal",
      "keywords": [
        "legal",
        "federal-law",
